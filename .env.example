# 真实模型模式（可选）。不配置时默认 mock，离线可完整演示。
# 复制为 .env 后填写；pnpm 不会自动加载，请用 shell 环境变量或 `docker compose --env-file .env up`。
DEEPSEEK_API_KEY=
# 可选：OpenAI 兼容网关地址
# BOLE_BASE_URL=https://api.deepseek.com
# 模型档位覆盖
# BOLE_FLASH_MODEL=deepseek-chat
# BOLE_PRO_MODEL=deepseek-reasoner
# 运行参数
# BOLE_LLM=mock
# BOLE_DB=data/ledger.db
# BOLE_RUNS=runs
# BOLE_INBOX=data/inbox
# BOLE_MOCK_LATENCY_MS=8
