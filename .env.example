# DeepSeek Key 不再从环境变量读取；启动 Web 后在页面绑定一次，服务端加密持久化。
# 可选：OpenAI 兼容网关
# BOLE_BASE_URL=https://api.deepseek.com

# 模型档位覆盖
# BOLE_FLASH_MODEL=deepseek-flash
# BOLE_PRO_MODEL=deepseek-v4-pro

# 数据与运行目录
# BOLE_DATA_DIR=data
# BOLE_DB=data/ledger.db
# BOLE_RUNS=runs
# BOLE_UPLOADS=data/uploads
# BOLE_OCR_DIR=data/ocr

# 图片 OCR：deepseek（默认，DeepSeek Vision）/ local（Tesseract）/ url（外部服务）
# BOLE_OCR_MODE=deepseek
# BOLE_OCR_MODEL=deepseek-flash
# BOLE_OCR_FALLBACK=true

# 外部 OCR（可选；url 模式或本地回退）
# BOLE_OCR_URL=http://127.0.0.1:9000/ocr
# BOLE_OCR_KEY=
# BOLE_OCR_LANG=chi_sim+eng
