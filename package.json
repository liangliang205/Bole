{
  "name": "bole",
  "version": "0.1.0",
  "private": true,
  "description": "伯乐 BoLe —— 可验证的多 Agent 招聘筛选编排平台（MVP）",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "bole": "./src/cli/index.ts"
  },
  "scripts": {
    "bole": "node src/cli/index.ts",
    "web": "node src/cli/index.ts web",
    "dev": "node --watch src/cli/index.ts",
    "test": "node --test --test-isolation=none tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:all": "node --test --test-isolation=none tests/unit/*.test.ts tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm test:all",
    "workflow:example": "node scripts/workflow-example.ts",
    "ocr:download": "node scripts/download-ocr.ts",
    "report:cost": "node src/cli/index.ts cost",
    "setup": "pnpm install && pnpm ocr:download",
    "reset": "node src/cli/index.ts reset"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tool-workspace-dependencies": "0.1.7-alpha.1",
    "@deepseek-ai/libreoffice-kit": "^0.2.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tencent-qqmail/agently-cli": "^1.0.18",
    "bmp-js": "^0.1.0",
    "docx": "^9.15.1",
    "idb-keyval": "^6.3.0",
    "imapflow": "^2.11.0",
    "is-url": "^1.2.4",
    "node-fetch": "^2.7.0",
    "npm": "^11.21.2",
    "partial-json": "^0.1.7",
    "pdfjs-dist": "4.10.38",
    "regenerator-runtime": "^0.13.11",
    "skills": "^1.7.6",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "wasm-feature-detect": "^1.9.0",
    "yaml": "^2.9.1",
    "zlibjs": "^0.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
