      "tier": "pro",
      "tools": [],
      "capabilities": ["rag_search", "fairness_scan", "scorecard_validate"],
      "mcp": [],
      "maxDepth": 0,
      "canDelegate": false,
      "outputSchema": "jd_analysis",
      "prompt": "prompts/profiler.md",
      "version": "1.0.0"
    },
    "fetcher": {
      "id": "fetcher",
      "nameZh": "探马",
