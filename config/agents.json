      "tier": "pro",
      "tools": [],
      "capabilities": ["span_verify", "fairness_scan", "ledger_query"],
      "mcp": [],
      "maxDepth": 0,
      "canDelegate": false,
      "outputSchema": "review_eval",
      "prompt": "prompts/auditor.md",
      "version": "1.0.0"
    }
