      "tools": [],
      "capabilities": ["read_resume", "span_locate"],
      "mcp": [],
      "maxDepth": 0,
      "canDelegate": false,
      "outputSchema": "parse_resume",
      "prompt": "prompts/parser.md",
      "version": "1.0.0"
    },
    "assessor": {
      "id": "assessor",
      "nameZh": "相马官",
