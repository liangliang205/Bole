      "tier": "flash",
      "tools": [],
      "capabilities": ["upload_read", "dedup", "normalize", "ocr"],
      "mcp": [],
      "maxDepth": 0,
      "canDelegate": false,
      "outputSchema": "fetch_manifest",
      "prompt": "prompts/fetcher.md",
      "version": "2.0.0"
    },
    "parser": {
      "id": "parser",
      "nameZh": "录事",
      "role": "把单份简历结构化为字段 + 证据 span",
