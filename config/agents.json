{
  "version": "1.3.0",
  "agents": {
    "coordinator": {
      "id": "coordinator",
      "nameZh": "伯乐",
      "role": "主 Agent：上传后决定是否扇出与各阶段并发；编排筛选流水线；完成后对话按任务难度选择 flash/pro",
      "tier": "pro",
      "tools": ["export_word", "office_export_pdf", "load_workspace_dependencies", "python_exec"],
      "capabilities": ["pipeline_orchestration", "screening_plan", "dispatch", "hitl", "aggregate", "chat_tiering"],
      "mcp": ["*"],
      "maxDepth": 1,
      "canDelegate": true,
      "outputSchema": "coordinator_plan",
      "prompt": "prompts/coordinator.md",
      "version": "1.3.0"
    },
    "profiler": {
      "id": "profiler",
      "nameZh": "需求画像师",
