# Copy to .env.production; never commit the filled file.
BOLE_DOMAIN=jobs.example.com
BOLE_AUTH_USER=hr
# Generate interactively: docker run --rm -it caddy:2-alpine caddy hash-password
# Single quotes prevent Compose from interpreting dollar signs in the hash.
BOLE_AUTH_HASH='$2a$14$REPLACE_WITH_GENERATED_HASH'
BOLE_IMAGE=bole:release-1
BOLE_MEMORY_LIMIT=2g
BOLE_CPUS=2.0
# Use approved digests for reproducible releases.
NODE_IMAGE=node:24-bookworm-slim
CADDY_IMAGE=caddy:2-alpine
